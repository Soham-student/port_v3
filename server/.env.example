# Copy to .env and edit.
PORT=5000
NODE_ENV=development

# Local MongoDB, or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Origin(s) allowed to call the API from a browser (comma separated).
# Not needed in production if the server serves the built client itself.
CLIENT_ORIGIN=http://localhost:5173

# Admin account, created on first start if it does not exist yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
